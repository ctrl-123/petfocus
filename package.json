{
  "name": "petfocus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "自律岛 / PetFocus —— 会管住你、也会陪着你的个人工作台",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/nutrition-db/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --test --experimental-strip-types \"packages/shared/src/**/*.test.ts\" \"packages/nutrition-db/src/**/*.test.ts\" \"apps/web/src/**/*.test.ts\"",
    "test:watch": "node --test --watch --experimental-strip-types \"packages/shared/src/**/*.test.ts\" \"packages/nutrition-db/src/**/*.test.ts\" \"apps/web/src/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --experimental-strip-types \"packages/shared/src/**/*.test.ts\" \"packages/nutrition-db/src/**/*.test.ts\" \"apps/web/src/**/*.test.ts\"",
    "dev": "pnpm --filter @petfocus/web dev",
    "build": "pnpm --filter @petfocus/web build",
    "lint": "eslint .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "fake-indexeddb": "6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "dexie": "4"
  }
}
